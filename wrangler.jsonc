{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "spotify-random-album",
  "compatibility_date": "2026-10-16",
  // No "main" or "assets": the Cloudflare Vite plugin builds an assets-only Worker into dist/ and points
  // `wrangler deploy` at it
  //
  // Deploys replace every custom domain on the Worker with this list, so the Preview domain must live here too or a
  // deploy removes it. enabled = serves production, previews_enabled = serves Previews at *.<pattern>
  "routes": [
    { "pattern": "rsa.autist.network", "custom_domain": true },
    {
      "pattern": "rsa-preview.autist.network",
      "custom_domain": true,
      "enabled": false,
      "previews_enabled": true
    }
  ],
  // Per-version preview links (<version>-spotify-random-album.<subdomain>.workers.dev) for non-production
  // branches. Wrangler leaves them unset when routes exist, so turn them on; the bare workers.dev URL stays off.
  "workers_dev": false,
  "preview_urls": true,
  // Required by `wrangler preview`; empty because there are no bindings to override
  "previews": {}
}
